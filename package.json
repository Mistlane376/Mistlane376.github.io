{
  "name": "mistlane-blog",
  "version": "0.0.0",
  "private": true,
  "description": "Mistlane 的个人博客，由 Hexo 和本地主题 themes/mistlane 构建。",
  "scripts": {
    "build": "npm run assets:prepare && hexo clean && hexo generate && npm run check:site",
    "assets:prepare": "node scripts/copy-pjax.js",
    "bangumi:update": "node tools/update-bangumi.js",
    "album:encrypt": "node tools/private-album.js",
    "admin": "node tools/blog-manager.js",
    "post:new": "hexo new-template",
    "moment:new": "hexo moment",
    "check:site": "node tools/regression-check.js",
    "server": "hexo server",
    "dev": "hexo server",
    "clean": "hexo clean",
    "deploy:prod": "npx vercel --prod"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-abbrlink": "^2.2.1",
    "hexo-butterfly-tag-plugins-plus": "^1.0.9",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-util": "^4.0.0",
    "hexo-wordcount": "^6.0.1",
    "js-yaml": "^5.4.3",
    "moment-timezone": "^0.6.0",
    "nib": "^1.2.0",
    "pjax": "^0.2.8",
    "stylus": "^0.64.0"
  }
}
