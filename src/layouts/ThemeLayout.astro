---
import { load } from 'cheerio';
import Appearance from '../components/Appearance.jsx';
import Search from '../components/Search.svelte';

// Keep the static theme adapter while Astro owns the document and island lifecycle.
// These global islands live outside PJAX's replacement selectors, like the audio.
const { html } = Astro.props;
const $ = load(html);
$('#mistlane-settings-panel, #mistlane-settings-backdrop, #local-search').remove();
$('script[src]').each((_, element) => {
  if (/\/(appearance-settings|local-search)\.js(?:\?|$)/.test($(element).attr('src') || '')) $(element).remove();
});
const htmlAttributes = $('html').attr();
const bodyAttributes = $('body').attr();
const head = $('head').html();
const body = $('body').html();
---
<!doctype html>
<html {...htmlAttributes}>
  <head><Fragment set:html={head} /></head>
  <body {...bodyAttributes}>
    <Fragment set:html={body} />
    <Appearance client:load />
    <Search client:load />
  </body>
</html>
