//- 搜索面板：顶部标题栏 + 输入框 + 推荐查找 + 结果/统计 + 键盘提示
-
  //- 从站点数据里挑出出现频率最高的标签与分类，作为一键搜索的推荐词
  const quickItems = []
  const seenQuick = new Set()
  const pushQuick = (name, type) => {
    const label = String(name || '').trim()
    if (!label || label.length > 14 || seenQuick.has(label)) return
    seenQuick.add(label)
    quickItems.push({ name: label, type: type })
  }
  const byLength = (a, b) => (b.length || 0) - (a.length || 0)
  ;(site.tags ? site.tags.toArray() : []).slice().sort(byLength).slice(0, 7).forEach(item => pushQuick(item.name, 'tag'))
  ;(site.categories ? site.categories.toArray() : []).slice().sort(byLength).slice(0, 4).forEach(item => pushQuick(item.name, 'category'))
  const quickData = JSON.stringify(quickItems.slice(0, 9))

#local-search
  .search-dialog(role="dialog" aria-modal="true" aria-label=_p('search.title'))
    nav.search-nav
      span.search-dialog-title= _p('search.title')
      i.fas.fa-spinner.fa-pulse#loading-status(hidden)
      button.search-close-button(type="button" aria-label=_p('search.close_button'))
        i.fas.fa-times

    #loading-database.text-center
      i.fas.fa-spinner.fa-pulse
      span= '  ' + _p("search.load_data")

    .local-search-input
      input(placeholder=theme.search.placeholder || _p("search.input_placeholder") type="text" autocomplete="off" spellcheck="false" aria-label=_p('search.title'))

    #local-search-count.mistlane-search-count(role="status" aria-live="polite")

    .mistlane-search-suggest(data-suggestions=quickData)
      .mistlane-search-suggest-head
        i.fas.fa-compass(aria-hidden="true")
        span= _p('search.suggest')
      .mistlane-search-suggest-chips

    hr

    #local-search-results
    #local-search-stats
    #local-search-pagination.ais-Pagination(style="display:none;")
      ul.ais-Pagination-list

    footer.mistlane-search-tip
      span.mistlane-search-tip-item
        kbd ↑
        kbd ↓
        em= _p('search.tip_choose')
      span.mistlane-search-tip-item
        kbd Enter
        em= _p('search.tip_open')
      span.mistlane-search-tip-item
        kbd Esc
        em= _p('search.tip_close')
      span.mistlane-search-tip-hint= _p('search.tip_hint')

  #search-mask
  script(src=url_for(theme.asset.local_search))
