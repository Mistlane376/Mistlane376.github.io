if theme.aside.card_post_series.enable && page.series
  - const array = fragment_cache('seriesArr', groupPosts)
  - const seriesPosts = array[page.series] || []
  if seriesPosts.length
    .card-widget.card-post-series
      .item-headline
        i.fa-solid.fa-layer-group
        span= theme.aside.card_post_series.series_title ? page.series : _p('aside.card_post_series')
      .aside-list
        each item in seriesPosts
          - const { path, title = _p('no_title'), date:dateA } = item
          .aside-list-item.no-cover(class=path === page.path ? 'is-current' : '')
            .content
              a.title(href=url_for(path) title=title)= title
              time(datetime=date_xml(dateA) title=_p('post.created') + ' ' + full_date(dateA)) #[=date(dateA, config.date_format)]
